generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             Int                @id @default(autoincrement())
  name           String
  venue          String
  exhibitor      String?
  booth          String?
  region         String             @default("San Diego")
  status         String             @default("draft")    // draft | dispatching | staffed
  approval       String             @default("pending")  // pending | approved
  createdAt      DateTime           @default(now())
  requirements   LaborRequirement[]
  assignments    Assignment[]
}

model LaborRequirement {
  id             Int          @id @default(autoincrement())
  eventId        Int
  laborType      String
  laborCount     Int
  installDates   String       @default("[]")
  dismantleDates String       @default("[]")
  flagged        Boolean      @default(false) // true = ran out of laborers to contact
  event          Event        @relation(fields: [eventId], references: [id])
  assignments    Assignment[]
}

model Laborer {
  id          Int          @id @default(autoincrement())
  name        String
  phone       String       @unique
  email       String?
  rate        Float
  jobType     String
  priority    String       @default("D")
  region      String       @default("San Diego")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

model Assignment {
  id            Int              @id @default(autoincrement())
  eventId       Int
  laborerId     Int
  requirementId Int
  status        String           @default("pending") // pending | accepted | rejected | expired
  sentAt        DateTime         @default(now())
  repliedAt     DateTime?
  event         Event            @relation(fields: [eventId], references: [id])
  laborer       Laborer          @relation(fields: [laborerId], references: [id])
  requirement   LaborRequirement @relation(fields: [requirementId], references: [id])
}
